{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "tvIp",
            "type": "promptString",
            "description": "Enter Android TV IP address (e.g. 192.168.8.108)",
            "default": "192.168.8.108"
        }
    ],
    "tasks": [
        {
            "label": "Android Launcher: Run on Simulator",
            "type": "shell",
            "command": "./scripts/run_app.sh run emulator",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: Run on Home TV",
            "type": "shell",
            "command": "./scripts/run_app.sh run tv",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: Run on TV (Custom IP)",
            "type": "shell",
            "command": "./scripts/run_app.sh run ${input:tvIp}",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: Hot Reload / Fast Restart (Simulator)",
            "type": "shell",
            "command": "./scripts/run_app.sh reload emulator",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: Hot Reload / Fast Restart (Home TV)",
            "type": "shell",
            "command": "./scripts/run_app.sh reload tv",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: Start TV Simulator",
            "type": "shell",
            "command": "./scripts/run_app.sh emulator-start",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: Connect to Home TV (ADB)",
            "type": "shell",
            "command": "./scripts/run_app.sh connect-tv tv",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: Connect to Custom TV IP (ADB)",
            "type": "shell",
            "command": "./scripts/run_app.sh connect-tv ${input:tvIp}",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: Build Debug APK",
            "type": "shell",
            "command": "./gradlew assembleDebug",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: View Simulator Logs (logcat)",
            "type": "shell",
            "command": "adb -s emulator-5554 logcat -v time dev.plume:V *:S",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: View Home TV Logs (logcat)",
            "type": "shell",
            "command": "adb -s 192.168.8.108:5555 logcat -v time dev.plume:V *:S",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android Launcher: Sync Upstream",
            "type": "shell",
            "command": "./scripts/sync_upstream.sh",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}
